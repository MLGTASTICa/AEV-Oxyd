{
	"eslint.nodePath": "./tgui/.yarn/sdks",
	"eslint.workingDirectories": [
		"./tgui"
	],
	"prettier.prettierPath": "./tgui/.yarn/sdks/prettier/index.cjs",
	"typescript.tsdk": "./tgui/.yarn/sdks/typescript/lib",
	"typescript.enablePromptUseWorkspaceTsdk": true,
	"search.exclude": {
		"**/.yarn": true,
		"**/.pnp.*": true
	},
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit"
	},
	"files.insertFinalNewline": true,
	"files.trimTrailingWhitespace": true,
	"editor.insertSpaces": false,
	"gitlens.advanced.blame.customArguments": [
		"-w"
	],
	"[javascript]": {
		"editor.rulers": [80],
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[javascriptreact]": {
		"editor.rulers": [80],
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[typescript]": {
		"editor.rulers": [80],
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[typescriptreact]": {
		"editor.rulers": [80],
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[scss]": {
		"editor.rulers": [80],
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"files.associations": {
		"*.dmi": "dmiEditor.dmiEditor"
	},
	"workbench.colorCustomizations": {
		"activityBar.background": "#032F03",
		"titleBar.activeBackground": "#044104",
		"titleBar.activeForeground": "#EFFEEF",
		"titleBar.inactiveBackground": "#032F03",
		"titleBar.inactiveForeground": "#EFFEEF",
		"statusBar.background": "#032F03",
		"statusBar.foreground": "#EFFEEF",
		"statusBar.debuggingBackground": "#032F03",
		"statusBar.debuggingForeground": "#EFFEEF",
		"statusBar.noFolderBackground": "#032F03",
		"statusBar.noFolderForeground": "#EFFEEF"
	}
}
